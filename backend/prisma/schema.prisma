generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  events       Event[]
  reservations Reservation[]

  @@map("users")
}

model Event {
  id           String        @id @default(uuid())
  organizerId  String
  title        String
  description  String?
  type         EventType
  startAt      DateTime
  endAt        DateTime?
  venue        String
  address      String?
  capacity     Int
  ticketPrice  Decimal       @db.Decimal(10, 2)
  status       EventStatus   @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  slug         String        @unique
  organizer    User          @relation(fields: [organizerId], references: [id])
  reservations Reservation[]

  @@index([organizerId])
  @@index([status])
  @@index([startAt])
  @@map("events")
}

model Reservation {
  id          String            @id @default(uuid())
  customerId  String
  eventId     String
  quantity    Int
  unitPrice   Decimal           @db.Decimal(10, 2)
  totalAmount Decimal           @db.Decimal(10, 2)
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  customer    User              @relation(fields: [customerId], references: [id])
  event       Event             @relation(fields: [eventId], references: [id])
  tickets     Ticket[]

  @@index([customerId])
  @@index([eventId])
  @@index([status])
  @@map("reservations")
}

model Ticket {
  id            String       @id @default(uuid())
  reservationId String
  code          String       @unique
  status        TicketStatus @default(ACTIVE)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())
  reservation   Reservation  @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([status])
  @@map("tickets")
}

enum UserRole {
  ORGANIZER
  CUSTOMER
  GATEKEEPER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum EventType {
  MOVIE
  SHOW
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}
